# Copy this file to .env and fill in real values. .env is gitignored.

# Neo4j (AuraDB)
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=<from Aura credentials>
NEO4J_PASSWORD=<from Aura credentials>
NEO4J_DATABASE=<your Aura database name, often same as instance ID>

# Postgres (Supabase)
# Use the session pooler host (aws-0-<region>.pooler.supabase.com), not the
# direct db.<ref>.supabase.co host — the direct host is IPv6-only and
# unreachable from most home/office networks.
POSTGRES_DSN=postgresql://<user>:<password>@<host>:5432/<db>

# Gemini (entity extraction, routing, answer synthesis)
GEMINI_API_KEY=<your key>
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: model for Phase 4 answer synthesis; falls back to GEMINI_MODEL.
# GEMINI_ANSWER_MODEL=gemini-3.1-flash-lite
